---
import "../styles/global.css";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  skipLabel: string;
}

const { lang, title, description, skipLabel } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const englishUrl = new URL("/en/", Astro.site);
const spanishUrl = new URL("/es/", Astro.site);
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonicalUrl.href,
  mainEntity: {
    "@type": "Person",
    "@id": "https://santiagopourteau.com/#person",
    name: "Santiago Pourteau",
    url: "https://santiagopourteau.com/",
    jobTitle: "AI Engineer",
    description,
    sameAs: [
      "https://github.com/SantiPourteau",
      "https://www.linkedin.com/in/santiago-pourteau-1bba8619a/",
    ],
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "es" ? "es_AR" : "en_US"} />
    <meta property="og:site_name" content="Santiago Pourteau" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
  </body>
</html>
